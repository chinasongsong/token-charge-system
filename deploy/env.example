# 复制本文件为 deploy/.env 后填写；不要将含真实密钥的 .env 提交到 Git。

# MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=token_charge
MYSQL_PORT=3306

# Redis
REDIS_PORT=6379

# gateway-service（路由目标；默认值与本机端口一致）
# TOKENS_GATEWAY_ADAPTER_URI=http://127.0.0.1:8102
# TOKENS_GATEWAY_USER_URI=http://127.0.0.1:8101
# TOKENS_GATEWAY_BILLING_URI=http://127.0.0.1:8103
# P3 起：Redis 供网关限流（本机 Compose 默认 6379）；未起 Redis 时网关会启动失败
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# billing-service 与 adapter 调用 /internal 共用
# BILLING_INTERNAL_TOKEN=
# /v1 等大模型路由下游读超时（毫秒，默认 600000=10 分钟；勿写「120」误当 120 秒）
# TOKENS_GATEWAY_RESPONSE_TIMEOUT=600000
# 与 user-center 签发 JWT 相同的密钥时，网关可对 Bearer JWT 校验并注入 X-User-Id（可选）
# JWT_SECRET=

# adapter-service（DeepSeek 服务端密钥，勿暴露给客户端）
# DEEPSEEK_API_KEY=
# 可选：覆盖默认上游 API 根地址（库表 model_providers.base_url 优先）
# DEEPSEEK_BASE_URL_FALLBACK=https://api.deepseek.com

# user-center-service（本机直连 MySQL 容器时，与 spring.datasource 环境变量对齐）
# MYSQL_JDBC_URL=jdbc:mysql://127.0.0.1:3306/token_charge?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
# MYSQL_USERNAME=root
# MYSQL_PASSWORD=与 MYSQL_ROOT_PASSWORD 一致
# JWT_SECRET=至少32个字符的UTF-8密钥（生产务必注入，勿用示例）

# billing-service：平台内对账自检（订单 vs usage_ledger），默认关闭
# BILLING_RECONCILIATION_ENABLED=false
# BILLING_RECONCILIATION_CRON=0 0 3 * * ?
# BILLING_RECONCILIATION_STALE_PENDING_HOURS=1

# payment-service：INIT 订单观测与超龄告警，默认关闭；不自动入账未支付单
# PAYMENT_RECONCILE_ENABLED=false
# PAYMENT_RECONCILE_CRON=0 */10 * * * ?
# PAYMENT_RECONCILE_STALE_INIT_WARN_MINUTES=60

# RabbitMQ（取消注释 Compose 占位段前先填写）
# RABBITMQ_USER=guest
# RABBITMQ_PASS=guest
# RABBITMQ_PORT_AMQP=5672
# RABBITMQ_PORT_UI=15672

# Observability（取消注释占位段前先准备 prometheus.yml）
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000

# 通用
TZ=Asia/Shanghai
